# Copy to backend/.env — never commit .env

# --- LLM: Gemini (default template) / Groq / OpenAI ---
# groq | openai | gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-from-aistudio
# Stable: gemini-2.5-flash. Fallbacks: gemini-1.5-flash, gemini-2.0-flash (quota varies)
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings: Hugging Face (recommended) or openai ---
EMBEDDING_PROVIDER=huggingface
# If job match spins forever, use: EMBEDDING_PROVIDER=none (keyword-only, instant)
HF_API_TOKEN=hf_your-huggingface-token-here
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# After ~MATCH_EMBED_TIMEOUT_SEC seconds, match falls back to keyword score (default 42)
# MATCH_EMBED_TIMEOUT_SEC=42
# --- Later: Groq fallback (uncomment; set LLM_PROVIDER=groq) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# Optional
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-3.5-turbo
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://YOUR_EXTENSION_ID

# --- Optional: send recruiter emails from the backend (Gmail app password, etc.) ---
# SMTP_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
# SMTP_MAX_SENDS_PER_HOUR=20
